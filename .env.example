# Copy to .env. Values below are placeholders; populate privately.
NODE_ENV=
API_PORT=
DATABASE_URL=
SESSION_SECRET=
# Comma-separated exact frontend origins, including scheme and port.
APP_ORIGINS=
TRUST_PROXY_HOPS=
MAX_UPLOAD_MB=
# local or s3. Production local requires a durable mounted volume.
STORAGE_DRIVER=
STORAGE_PATH=
STORAGE_PUBLIC_URL=
STORAGE_PERSISTENT_DISK=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# One-time setup only. Remove ADMIN_PASSWORD after account creation.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
# Leave empty when /api is reverse-proxied through the frontend origin (recommended).
VITE_API_BASE_URL=
# Optional dedicated test database, never a production database.
TEST_DATABASE_URL=
