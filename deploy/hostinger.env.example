# Mauli Lawns: production environment template.
# Copy to the backend's private .env, or enter values in hosting Environment Variables.
# Replace every REPLACE_* value. Do not overwrite the existing local .env.
# Never commit the completed .env or put database/secrets in VITE_* variables.

NODE_ENV=production
# Leave blank to use the PORT assigned by Hostinger automatically.
# Set only if your hosting configuration explicitly requires an override.
API_PORT=

# Full Hostinger username/database name, including the account prefix.
# URL-encode username/password special characters. Use the provider's DB host.
DATABASE_URL="mysql://REPLACE_DB_USER:REPLACE_URL_ENCODED_DB_PASSWORD@REPLACE_DB_HOST:3306/REPLACE_DB_NAME"

# Generate privately: openssl rand -hex 48
# Keep this secret stable across restarts; do not reuse the DB/admin password.
SESSION_SECRET=REPLACE_WITH_GENERATED_SESSION_SECRET

# Exact public frontend origin(s), HTTPS, comma-separated, no trailing slash.
# Include www only if you actually serve the frontend there.
APP_ORIGINS=https://REPLACE_FRONTEND_DOMAIN
# Number of trusted upstream proxies terminating HTTPS. Confirm with hosting setup.
# Example: 1 only when exactly one trusted proxy sits in front of this Express API.
TRUST_PROXY_HOPS=REPLACE_WITH_VERIFIED_PROXY_COUNT
MAX_UPLOAD_MB=10

# OPTION A: persistent local disk. Confirm the directory survives redeployments.
STORAGE_DRIVER=local
STORAGE_PATH=/REPLACE_WITH_ABSOLUTE_PERSISTENT_UPLOADS_DIRECTORY
# Example when API is on a same-site subdomain: https://api.example.com/uploads
STORAGE_PUBLIC_URL=https://REPLACE_API_DOMAIN/uploads
# Change to true ONLY after persistent storage has been configured/verified.
# Production startup intentionally refuses local storage while this remains false.
STORAGE_PERSISTENT_DISK=false

# OPTION B: if persistent local disk is unavailable, use S3-compatible storage.
# Set STORAGE_DRIVER=s3, fill the values below, and set STORAGE_PUBLIC_URL
# to the bucket/CDN's public HTTPS prefix instead of the API /uploads URL.
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# First-time admin creation only: npm run db:admin
# Use a real email and a unique password (12+ chars, upper/lowercase and number;
# maximum 72 UTF-8 bytes). Remove ADMIN_PASSWORD after successful setup.
ADMIN_USERNAME=mauliadmin
ADMIN_FULL_NAME="Mauli Lawns Admin"
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_ADMIN_PASSWORD

# FRONTEND build-time value. Example: https://api.example.com
# Keep the API on the same site (api.example.com for www.example.com) for login cookies.
# Leave empty ONLY if production reverse-proxies /api to the backend.
# The Vite development proxy does not configure production routing.
VITE_API_BASE_URL=https://REPLACE_API_DOMAIN

# Leave empty in production. Tests must never run against the production database.
TEST_DATABASE_URL=
